# Base URL of the Express backend (POST /register, POST /login)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Authenticated WebSocket endpoint
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# "true" (default) uses the local mock services in lib/mock.
# Set to "false" to use the real backend services in lib/api.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Optional per-service overrides. Each falls back to NEXT_PUBLIC_USE_MOCK_DATA
# when unset, so you can connect one side at a time during integration.
NEXT_PUBLIC_USE_MOCK_AUTH=true
NEXT_PUBLIC_USE_MOCK_CHAT=true
